# ---- Data source ---------------------------------------------------------------
# kite = your real Kite account. demo = synthetic prices to try the desk.
DATA_MODE=kite

# ---- Kite Connect (developers.kite.trade, paid Connect plan) ---------------------
KITE_API_KEY=
KITE_API_SECRET=
# Public HTTPS address of this app. Set the Kite app's Redirect URL to <PUBLIC_URL>/kite/callback
PUBLIC_URL=https://trade.example.com

# ---- Trading modes ----------------------------------------------------------------
# Test mode is always available: simulated orders on live prices.
PAPER_CAPITAL=100000
# Automatic mode (REAL orders) needs all of: this switch, a budget, a dashboard password,
# an authenticator app set up in Controls, a Kite login, and password + code at switch time.
LIVE_TRADING_ENABLED=false
LIVE_CAPITAL=
# true = Automatic switches itself back to Test at 06:00 and needs verifying again each day
AUTO_REVERIFY_DAILY=false

# ---- Execution ------------------------------------------------------------------
PRODUCT=CNC
ALLOW_INTRADAY_SHORTS=false
SLIPPAGE_BPS=5
MAX_POSITIONS=10

# ---- Optional risk limits (blank = off) -------------------------------------------
MAX_POSITION_PCT=
DAILY_LOSS_LIMIT_PCT=
STOP_LOSS_PCT=

# ---- Universe ---------------------------------------------------------------------
# nifty50 | nifty100 | nifty200 | nifty500 | niftymidcap150 | niftysmallcap250 | all
UNIVERSE_INDEX=nifty100
EXCHANGES=NSE,BSE
EXTRA_SYMBOLS=

# ---- Claude decision desk (blank key = rule set) ----------------------------------
ANTHROPIC_API_KEY=
DEEP_MODEL=claude-sonnet-5-5
QUICK_MODEL=claude-haiku-5-5
USE_WEB_NEWS=true
CANDIDATES_PER_CYCLE=5

# ---- ML model ----------------------------------------------------------------------
# Share of the final score that comes from the model (0 = rules only)
ML_WEIGHT=0.4
ML_AUTO_RETRAIN=true
# New models switch on by themselves only at or above this holdout AUC
ML_MIN_AUC=0.52
ML_HISTORY_DAYS=1200
RETRAIN_TIME=fri 15:40

# ---- Schedule (IST) ------------------------------------------------------------------
CYCLE_MINUTES=15
MARKET_OPEN=09:20
MARKET_CLOSE=15:15
LOGIN_REMINDER=08:45
NSE_HOLIDAYS=

# ---- Phone alerts ----------------------------------------------------------------------
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Security ----------------------------------------------------------------------------
DASHBOARD_PASSWORD=
# long random string, e.g. from: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
TOTP_ISSUER=Agent Desk
